{
    "mcpServers": {
        "laravel-boost": {
            "command": "cmd",
            "args": [
                "/c",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcnVue": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "shadcn-vue@latest",
                "mcp"
            ]
        }
    }
}
